{
  "expo": {
    "name": "Lo Ride",
    "slug": "lo-ride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loloride.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lo Ride needs your location to find rides in your metro city.",
        "NSLocationAlwaysUsageDescription": "Lo Ride needs your location to find rides in your metro city.",
        "NSMicrophoneUsageDescription": "Lo Ride needs access to your microphone for secure in-app voice calls between drivers and verified passengers."
      },
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "package": "com.loloride.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0284c7"
      },
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lo Ride needs your location to find rides in your metro city."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0284c7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lo Ride to access your photos to upload DL and RC documents."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Lo Ride to access your microphone for secure in-app voice calls between drivers and passengers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1fcafd08-8e30-4bad-9465-9cf091664e67"
      }
    },
    "owner": "harireddypraba"
  }
}
